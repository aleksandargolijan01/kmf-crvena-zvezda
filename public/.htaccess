# Angular SPA rules for Apache and LiteSpeed hosting at the domain root.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Keep cPanel/AutoSSL challenges and real files or directories out of the SPA fallback.
  RewriteRule ^\.well-known(?:/|$) - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Angular handles every remaining route client-side.
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Angular production bundles are content-hashed and safe to cache permanently.
  <FilesMatch "(?i)-[a-z0-9]{8,}\.(?:js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Public assets keep stable names, so use a shorter cache lifetime.
  <FilesMatch "(?i)\.(?:avif|gif|ico|jpe?g|png|svg|webp|woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </FilesMatch>

  <FilesMatch "(?i)\.(?:json|xml|txt)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # Always revalidate the app shell so it references the newest hashed bundles.
  <Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </Files>

  # These files must never be stale if Angular service worker support is enabled later.
  <FilesMatch "^(?:ngsw\.json|ngsw-worker\.js|safety-worker\.js|worker-basic\.min\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
