# Application
NODE_ENV="production"
PORT="3000"
FRONTEND_ORIGINS="https://kmfcrvenazvezda.rs,https://www.kmfcrvenazvezda.rs"

# PostgreSQL / Prisma
# Use the pooled Supabase URL at runtime and the direct URL for Prisma migrations.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/DATABASE?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?schema=public"

# Supabase Storage
SUPABASE_URL="https://PROJECT_ID.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"
SUPABASE_STORAGE_BUCKET="kmf-czv"

# Authentication
# Replace both placeholders with different random secrets of at least 32 characters.
JWT_SECRET="replace-with-jwt-secret"
JWT_REFRESH_SECRET="replace-with-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# OpenAI translation (optional; leave the API key empty to disable it safely)
OPENAI_API_KEY=""
OPENAI_TRANSLATION_MODEL="gpt-4.1-mini"

# SMTP and sponsor inquiry email (required only when the inquiry endpoint is enabled)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SPONSOR_INQUIRY_TO_EMAIL=""
SPONSOR_INQUIRY_FROM_EMAIL=""
SPONSOR_INQUIRY_REPLY_TO_ENABLED="true"

# Optional absolute or backend-relative logo path; empty uses backend/assets automatically.
SPONSOR_LOGO_PATH=""

# Shop checkout: separate random secret, at least 32 characters. Empty disables signing.
SHOP_TOKEN_SECRET=""
# Set the real season key before enabling season-ticket validation. No dataset is seeded.
SHOP_ACTIVE_SEASON=""
# JSON object of version -> independent random HMAC pepper (each at least 32 characters).
# Retain old versions until verifiers have been replaced. Never commit real keys.
SHOP_VERIFIER_KEYS='{}'
SHOP_VERIFIER_KEY_VERSION="1"
# Explicit opt-in: keep false for local development and automated tests.
SHOP_EMAIL_WORKER_ENABLED="false"
SHOP_ORDER_RECIPIENT_EMAIL=""
# Empty falls back to SPONSOR_INQUIRY_FROM_EMAIL, then SMTP_USER.
SHOP_ORDER_FROM_EMAIL=""

# Prisma seed only (optional). Uncomment temporarily when running npm run prisma:seed.
# SUPER_ADMIN_EMAIL="admin@example.com"
# SUPER_ADMIN_PASSWORD="replace-with-a-strong-password"
# SUPER_ADMIN_NAME="Super Admin"
