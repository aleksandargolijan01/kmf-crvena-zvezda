generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum MediaFileType {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

enum StaffTeamType {
  FIRST_TEAM
  U19_TEAM
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  refreshTokenHash String?
  firstName        String?
  lastName         String?
  role             UserRole @default(EDITOR)
  isActive         Boolean  @default(true)
  lastLoginAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  news News[]
  mediaFiles MediaFile[]
  orderStatusChanges OrderStatusHistory[]

  @@index([role])
  @@index([isActive])
}

model News {
  id          String   @id @default(cuid())
  slug        String   @unique
  title_sr    String
  title_en    String?
  title_ru    String?
  excerpt_sr  String?
  excerpt_en  String?
  excerpt_ru  String?
  content_sr  String
  content_en  String?
  content_ru  String?
  coverImage  String?
  coverImageId String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  featured    Boolean  @default(false)
  authorId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author     User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  coverMedia MediaFile? @relation(fields: [coverImageId], references: [id], onDelete: SetNull)

  @@index([published, publishedAt])
  @@index([featured, publishedAt])
  @@index([authorId])
  @@index([coverImageId])
}

model Player {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  fullName    String
  slug        String   @unique
  position    String?
  shirtNumber Int?
  bio_sr      String?
  bio_en      String?
  bio_ru      String?
  imageUrl    String?
  imageId     String?
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  image MediaFile? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([imageId])
  @@index([active, order])
}

model U19Player {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  fullName    String
  slug        String   @unique
  position    String?
  shirtNumber Int?
  bio_sr      String?
  bio_en      String?
  bio_ru      String?
  imageUrl    String?
  imageId     String?
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  image MediaFile? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([imageId])
  @@index([active, order])
}

model ManagementMember {
  id        String   @id @default(cuid())
  fullName  String
  slug      String   @unique
  role_sr   String
  role_en   String?
  role_ru   String?
  bio_sr    String?
  bio_en    String?
  bio_ru    String?
  imageUrl  String?
  imageId   String?
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  image MediaFile? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([imageId])
  @@index([active, order])
}

model BoardMember {
  id        String   @id @default(cuid())
  fullName  String
  slug      String   @unique
  role_sr   String   @default("Члан управног одбора")
  role_en   String?
  role_ru   String?
  bio_sr    String?
  bio_en    String?
  bio_ru    String?
  imageUrl  String?
  imageId   String?
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  image MediaFile? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([imageId])
  @@index([active, order])
}

model StaffMember {
  id        String        @id @default(cuid())
  fullName  String
  role_sr   String
  role_en   String?
  role_ru   String?
  bio_sr    String?
  bio_en    String?
  bio_ru    String?
  imageUrl  String?
  imageId   String?
  teamType  StaffTeamType
  active    Boolean       @default(true)
  order     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  image MediaFile? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([imageId])
  @@index([teamType, active, order])
}

model SponsorCategory {
  id             String    @id @default(cuid())
  name_sr        String
  name_en        String?
  name_ru        String?
  slug           String    @unique
  description_sr String?
  description_en String?
  description_ru String?
  order          Int       @default(0)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sponsors Sponsor[]

  @@index([active, order])
}

model Sponsor {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  websiteUrl     String?
  logoUrl        String?
  logoId         String?
  categoryId     String?
  description_sr String?
  description_en String?
  description_ru String?
  featured       Boolean  @default(false)
  active         Boolean  @default(true)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category SponsorCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  logo     MediaFile?       @relation(fields: [logoId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([logoId])
  @@index([featured])
  @@index([active, order])
}

model NewsletterSubscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  firstName        String?
  lastName         String?
  phone            String?
  source           String?
  consent          Boolean   @default(false)
  isActive         Boolean   @default(true)
  unsubscribeToken String    @unique
  consentGivenAt   DateTime?
  unsubscribedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([isActive])
  @@index([source])
  @@index([unsubscribedAt])
}

model MediaFile {
  id             String        @id @default(cuid())
  bucket         String
  storagePath    String        @unique
  url            String
  originalName   String
  fileName       String
  mimeType       String
  size           Int
  type           MediaFileType @default(IMAGE)
  altText        String?
  uploadedById   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  uploadedBy User?  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  newsCover  News[]
  playerImages Player[]
  u19PlayerImages U19Player[]
  managementImages ManagementMember[]
  boardImages BoardMember[]
  staffImages StaffMember[]
  sponsorLogos Sponsor[]
  productCovers Product[] @relation("ProductCover")
  productImages ProductImage[]
  deletingAt DateTime?

  @@index([type])
  @@index([uploadedById])
}

enum ProductAvailability {
  AVAILABLE
  SOLD_OUT
  MADE_TO_ORDER
}

enum OrderStatus {
  NEW
  CONFIRMED
  SHIPPED
  COMPLETED
  CANCELLED
}

enum OrderSource {
  WEBSITE
  INSTAGRAM
  PHONE
  IN_PERSON
  ADMIN
}

enum SeasonTicketVerificationMethod {
  LAST_NAME
  PHONE_LAST4
  PIN
}

enum OrderEmailKind {
  CLUB
  CUSTOMER
}

enum OrderEmailStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model Product {
  id                  String @id @default(cuid())
  slug                String @unique
  nameSr              String
  nameEn              String?
  nameRu              String?
  descriptionSr       String
  descriptionEn       String?
  descriptionRu       String?
  priceMinor          Int
  compareAtPriceMinor Int?
  active              Boolean @default(false)
  featured            Boolean @default(false)
  featuredOrder       Int?
  displayOrder        Int @default(0)
  availability        ProductAvailability @default(AVAILABLE)
  newUntil            DateTime?
  coverImageId        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  coverImage MediaFile? @relation("ProductCover", fields: [coverImageId], references: [id], onDelete: Restrict)
  gallery    ProductImage[]
  variants   ProductVariant[]
  orderItems OrderItem[]

  @@index([active, displayOrder, id])
  @@index([active, featured, featuredOrder, id])
  @@index([coverImageId])
}

model ProductImage {
  id           String @id @default(cuid())
  productId    String
  mediaFileId  String
  displayOrder Int @default(0)
  altSr        String?
  altEn        String?
  altRu        String?
  createdAt    DateTime @default(now())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Restrict)

  @@unique([productId, mediaFileId])
  @@index([productId, displayOrder, id])
  @@index([mediaFileId])
}

model ProductVariant {
  id            String @id @default(cuid())
  productId     String
  size          String
  sku           String? @unique
  active        Boolean @default(true)
  available     Boolean @default(true)
  displayOrder  Int @default(0)
  stockQuantity Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, size])
  @@index([productId, active, displayOrder, id])
}

model SeasonTicket {
  id                 String @id @default(cuid())
  seasonKey          String
  cardNumber         String
  active             Boolean @default(true)
  validFrom          DateTime?
  validUntil         DateTime?
  verificationMethod SeasonTicketVerificationMethod?
  verifierHash       String?
  verifierKeyVersion Int?
  version            Int @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  orders Order[]

  @@unique([seasonKey, cardNumber])
  @@index([seasonKey, active, validUntil])
}

model Order {
  id                 String @id @default(cuid())
  orderNumber        String @unique
  status             OrderStatus @default(NEW)
  source             OrderSource @default(WEBSITE)
  currency           String @default("RSD") @db.Char(3)
  country            String @default("RS") @db.Char(2)
  paymentMethod      String @default("COD")
  firstName          String
  lastName           String
  phone              String
  email              String?
  address            String
  city               String
  postalCode         String
  note               String?
  subtotalMinor      Int
  discountPercent    Int @default(0)
  discountMinor      Int @default(0)
  totalMinor         Int
  shippingMinor      Int?
  shippingCalculated Boolean @default(false)
  seasonTicketId     String?
  idempotencyKeyHash String? @unique
  requestHash        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  seasonTicket SeasonTicket? @relation(fields: [seasonTicketId], references: [id], onDelete: Restrict)
  items OrderItem[]
  statusHistory OrderStatusHistory[]
  emails OrderEmail[]

  @@index([status, createdAt, id])
  @@index([createdAt, id])
  @@index([seasonTicketId])
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  productId      String?
  variantId      String?
  productName    String
  productSlug    String
  sku            String?
  size           String
  quantity       Int
  unitPriceMinor Int
  subtotalMinor  Int
  discountMinor  Int @default(0)
  finalMinor     Int
  createdAt      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderStatusHistory {
  id          String @id @default(cuid())
  orderId     String
  status      OrderStatus
  changedById String?
  createdAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt, id])
  @@index([changedById])
}

model OrderNumberCounter {
  year      Int @id
  lastValue Int @default(0)
}

model OrderEmail {
  id            String @id @default(cuid())
  orderId       String
  kind          OrderEmailKind
  status        OrderEmailStatus @default(PENDING)
  attempts      Int @default(0)
  lastError     String?
  nextAttemptAt DateTime?
  sentAt        DateTime?
  lockedAt      DateTime?
  lockToken     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, kind])
  @@index([status, nextAttemptAt])
  @@index([status, lockedAt])
}
